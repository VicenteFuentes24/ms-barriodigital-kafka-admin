SERVER_PORT=8089
SERVER_ADDRESS=127.0.0.1
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092
# Required: set privately in the process environment. No default account/password.
KAFKA_ADMIN_USERNAME=
KAFKA_ADMIN_PASSWORD=
KAFKA_ADMIN_WRITES_ENABLED=false
# Additional protection; business topics and __* remain protected even if this is empty.
KAFKA_ADMIN_PROTECTED_TOPICS=bd.local.smoke.v1
KAFKA_ADMIN_TIMEOUT_MS=5000
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# true behind HTTPS in deployment; false only for local HTTP.
SESSION_COOKIE_SECURE=false
